{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "cli/**/*",
    "core/**/*",
    "agents/**/*",
    "utils/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
