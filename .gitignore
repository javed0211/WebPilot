# Dependencies
node_modules/

# Build / compile output
dist/
*.tsbuildinfo

# Local secrets only — .env.example is committed; copy to .env for real keys
.env
.env.*
!.env.example
.env.local
*.pem
credentials.json
service-account*.json

# Local config overlays (real keys / machine-specific overrides)
resources/config/llm.local.json
resources/config/webpilot.local.yaml
resources/config/*.secret.json

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
.envrc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.egg-info/
.eggs/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Cursor / local agent state
.cursor/

# Local agent/session state (not part of WebPilot)
runtime/workspace/

# Playwright & browser-use run artifacts (regenerated every run)
runtime/playwright-report/
runtime/test-results/
runtime/reports/
runtime/artifacts/*
!runtime/artifacts/.gitkeep
runtime/healing-cache/*
!runtime/healing-cache/.gitkeep
runtime/selectors/
runtime/screenshots/
runtime/fixtures/
runtime/auth-state/

# Page inventory snapshots (regenerated during browser-use discovery)
runtime/page-inventory/

# Playwright / codegen output at repo root (local validator runs)
test-results/

# Repository knowledge graph (regenerated before codegen)
runtime/knowledge/

# Understand-Anything local scratch (commit the graph JSON; ignore intermediates)
.ua/intermediate/
.ua/diff-overlay.json
.understand-anything/intermediate/
.understand-anything/diff-overlay.json

# Codegen traces, plans, and metadata (regenerated per run)
runtime/codegen/

# Requirement coverage + regression artifacts (regenerated by `webpilot coverage`)
runtime/requirements/

# Playwright test-framework workspace: ignore generated pages/tests/apis;
# keep scaffold (core/config/utils/data/playwright.config) tracked — src imports it.
packages/test-framework/*
!packages/test-framework/core/
!packages/test-framework/core/**
!packages/test-framework/config/
!packages/test-framework/config/**
!packages/test-framework/utils/
!packages/test-framework/utils/**
!packages/test-framework/data/
!packages/test-framework/data/**
!packages/test-framework/apis/
!packages/test-framework/apis/.gitkeep
!packages/test-framework/playwright.config.ts

# Vendored browser-use local caches / scratch
packages/browser-use/.venv/
packages/browser-use/**/__pycache__/
packages/browser-use/**/.pytest_cache/
packages/browser-use/**/.mypy_cache/

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
temp/
tmp/
*.ffmpeg.tmp

# Committed visual assets live under resources/assets/.
