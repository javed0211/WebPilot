# Dependencies
node_modules/

# Build / compile output
dist/
*.tsbuildinfo

# Local secrets only — .env.example is committed; copy to .env for real keys
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
.envrc

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Cursor / local agent state
.cursor/

# Local agent/session state (not part of WebPilot)
runtime/workspace/

# Playwright & browser-use run artifacts (regenerated every run)
runtime/playwright-report/
runtime/test-results/
runtime/reports/
runtime/artifacts/*
!runtime/artifacts/.gitkeep
runtime/healing-cache/*
!runtime/healing-cache/.gitkeep
runtime/selectors/

# Repository knowledge graph (regenerated before codegen)
runtime/knowledge/

# Codegen traces, plans, and metadata (regenerated per run)
runtime/codegen/

# Requirement coverage + regression artifacts (regenerated by `webpilot coverage`)
runtime/requirements/

# Codegen / validation scratch (local only)
packages/test-framework/temp_codegen.json

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
temp/
tmp/

# Committed visual assets live under resources/assets/.
