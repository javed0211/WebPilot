{
  "google": {
    "model": "gemini-2.5-flash",
    "apiKey": "${GEMINI_API_KEY}"
  },
  "openai": {
    "model": "gpt-4o",
    "apiKey": "${OPENAI_API_KEY}"
  },
  "anthropic": {
    "model": "claude-3-5-sonnet",
    "apiKey": "${ANTHROPIC_API_KEY}"
  },
  "ollama": {
    "model": "qwen2.5:3b",
    "endpoint": "http://localhost:11434"
  },
  "azure": {
    "model": "gpt-5.4",
